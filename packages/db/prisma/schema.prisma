// =====================================================================
// Schema LT Vending
// Multi-tenant: Tenant -> Users -> Machines -> Slots (planograma) -> Restocks.
// El modelo de inventario/surtido está portado de la-terraza-pos
// (apps/api/src/modules/vending), que ya opera la máquina real de
// Capithal Park (AMS VISI Combo 39"). Aquí es multi-tenant: cada tabla
// de negocio lleva tenantId y nunca se consulta sin ese filtro.
// Convenciones (iguales a la-terraza-pos, mismo stack):
//   - IDs: cuid() — corto, sortable, sin colisiones
//   - Dinero: Decimal(12, 2) en MXN
//   - Fechas en consultas agregadas: AT TIME ZONE 'America/Mexico_City'
//     (todo se guarda en UTC)
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// MULTI-TENANT & AUTH
// =====================================================================

/// Un operador de vending (el cliente de LT Vending). Todo dato de negocio
/// cuelga de un tenantId — ninguna query de negocio debe omitir este filtro.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  machines Machine[]
  products Product[]

  @@map("tenants")
}

enum UserRole {
  /// Dueño/operador: ve ventas, utilidad, alertas, administra el tenant.
  OWNER
  /// Surtidor: ve su ruta y qué cargar. Entra desde el celular.
  SURTIDOR
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  // Único de forma global (no por tenant): una cuenta = un email = un tenant
  // por ahora. Si en el futuro un mismo correo necesita pertenecer a varios
  // tenants, esto cambia a @@unique([tenantId, email]) y el login deja de
  // resolver el tenant solo con el email.
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(OWNER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  restocks      Restock[]
  wastes        WasteEntry[]
  collections   Collection[]

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// =====================================================================
// MÁQUINAS
// =====================================================================

model Machine {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  location  String?
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slots       Slot[]
  restocks    Restock[]
  wastes      WasteEntry[]
  collections Collection[]

  @@index([tenantId])
  @@map("machines")
}

// =====================================================================
// PRODUCTOS
// =====================================================================

model Product {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  sku       String?
  price     Decimal  @db.Decimal(12, 2)
  cost      Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slotItems    SlotItem[]
  restockLines RestockLine[]
  wastes       WasteEntry[]

  @@index([tenantId])
  @@map("products")
}

// =====================================================================
// PLANOGRAMA (espirales de la máquina)
// =====================================================================

/// Un espiral/canal. Vive en un nivel (charola) y puede llevar de 1 a 4
/// productos distintos (MAX_PRODUCTS_PER_SLOT en machines.service.ts).
model Slot {
  id        String   @id @default(cuid())
  tenantId  String
  machineId String
  level     Int // 1..n (la charola)
  position  Int // posición dentro del nivel
  code      String // etiqueta visible y editable, ej. "3-07" o "Jugos"
  capacity  Int // piezas que caben en el espiral completo, entre todos sus productos
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine Machine       @relation(fields: [machineId], references: [id], onDelete: Cascade)
  items   SlotItem[]
  lines   RestockLine[]
  wastes  WasteEntry[]

  @@unique([machineId, level, position])
  @@index([tenantId])
  @@index([machineId])
  @@map("slots")
}

/// Producto dentro de un espiral. La capacidad es del espiral completo y se
/// reparte entre los productos que le metas (hasta 4).
model SlotItem {
  id         String   @id @default(cuid())
  slotId     String
  productId  String
  currentQty Int      @default(0)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  slot    Slot    @relation(fields: [slotId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([slotId, productId])
  @@index([slotId])
  @@index([productId])
  @@map("slot_items")
}

// =====================================================================
// SURTIDO
// =====================================================================

/// Una visita a surtir. Al guardarla se calcula lo vendido por diferencia
/// (esperado − encontrado) y se guarda el valor y costo de esas piezas.
model Restock {
  id         String   @id @default(cuid())
  tenantId   String
  machineId  String
  userId     String
  soldUnits  Int      @default(0) // piezas inferidas como vendidas
  soldValue  Decimal  @default(0) @db.Decimal(12, 2) // a precio público
  soldCogs   Decimal  @default(0) @db.Decimal(12, 2) // costo de esas piezas
  addedUnits Int      @default(0) // piezas cargadas a la máquina
  notes      String?
  createdAt  DateTime @default(now())

  machine Machine       @relation(fields: [machineId], references: [id])
  user    User          @relation(fields: [userId], references: [id])
  lines   RestockLine[]

  @@index([tenantId])
  @@index([machineId])
  @@index([createdAt])
  @@map("restocks")
}

model RestockLine {
  id        String @id @default(cuid())
  restockId String
  slotId    String
  productId String

  expectedQty Int // lo que el sistema creía que había
  foundQty    Int // lo que realmente había (conteo)
  addedQty    Int // lo que se metió
  finalQty    Int // como quedó el espiral
  soldQty     Int // expectedQty − foundQty (nunca negativo)

  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2)
  saleValue Decimal @db.Decimal(12, 2)
  cogs      Decimal @db.Decimal(12, 2)

  restock Restock @relation(fields: [restockId], references: [id], onDelete: Cascade)
  slot    Slot    @relation(fields: [slotId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([restockId])
  @@index([slotId])
  @@index([productId])
  @@map("restock_lines")
}

enum WasteReason {
  JAMMED // se atoró
  EXPIRED // caducó
  DAMAGED // dañado
  THEFT // robo
  OTHER
}

/// Merma de la máquina. Sin esto, todo lo que falta se contaría como vendido
/// e infla las ventas — descuenta del stock del espiral si se indica slotId.
model WasteEntry {
  id        String      @id @default(cuid())
  tenantId  String
  machineId String
  slotId    String?
  productId String
  quantity  Int
  reason    WasteReason
  unitCost  Decimal     @db.Decimal(12, 2)
  notes     String?
  userId    String
  createdAt DateTime    @default(now())

  machine Machine @relation(fields: [machineId], references: [id])
  slot    Slot?   @relation(fields: [slotId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([machineId])
  @@index([createdAt])
  @@map("waste_entries")
}

/// Dinero recogido de la máquina, para cuadrar contra la venta inferida de
/// los surtidos (ver dashboard: cashDifference).
model Collection {
  id         String   @id @default(cuid())
  tenantId   String
  machineId  String
  cashAmount Decimal  @default(0) @db.Decimal(12, 2)
  cardAmount Decimal  @default(0) @db.Decimal(12, 2)
  notes      String?
  userId     String
  createdAt  DateTime @default(now())

  machine Machine @relation(fields: [machineId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([machineId])
  @@index([createdAt])
  @@map("collections")
}
