# --- Base de datos ---
DATABASE_URL="postgresql://ltvending:ltvending_dev@localhost:5433/ltvending?schema=public"

# --- Backend (NestJS) ---
API_PORT=3101
API_HOST=0.0.0.0
# PORT lo provee Railway automáticamente en producción (tiene prioridad sobre API_PORT)

# CORS en producción: orígenes permitidos separados por coma.
# Déjalo vacío en dev para aceptar cualquier origen local.
CORS_ORIGINS=""

# JWT — genera valores aleatorios para producción con: openssl rand -hex 32
JWT_SECRET="cambiame_en_produccion_con_openssl_rand_hex_32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="365d"

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:3101"
NEXT_PUBLIC_APP_NAME="LT Vending"

# --- Seed demo (cámbialo después del primer login) ---
SEED_TENANT_NAME="Capithal Park Colotlán"
SEED_OWNER_EMAIL="admin@ltvending.local"
SEED_OWNER_PASSWORD="admin1234"

BUSINESS_TIMEZONE="America/Mexico_City"
BUSINESS_CURRENCY="MXN"
