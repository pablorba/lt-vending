{
  "name": "lt-vending-sistema",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema LT Vending — control de máquinas, inventario y rutas de surtido",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @ltv/db prisma:generate",
    "db:push": "pnpm --filter @ltv/db prisma:push",
    "db:migrate": "pnpm --filter @ltv/db prisma:migrate",
    "db:seed": "pnpm --filter @ltv/db prisma:seed",
    "db:studio": "pnpm --filter @ltv/db prisma:studio",
    "db:reset": "pnpm --filter @ltv/db prisma:reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "setup": "pnpm install && pnpm docker:up && sleep 8 && pnpm db:push && pnpm db:seed"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0"
  }
}
